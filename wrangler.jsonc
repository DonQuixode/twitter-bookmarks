{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twitter-bookmarks",
  "main": "src/main.py",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["python_workers"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "twitter-bookmarks",
      "database_id": "2cd4f745-a3f3-4711-be09-1ec1bb4d2633"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vectorize": [
    {
      "binding": "VECTORS",
      "index_name": "twitter-bookmarks",
      "remote": true
    }
  ]
}
